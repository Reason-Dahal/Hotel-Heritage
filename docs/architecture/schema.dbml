// Database Schema - Hotel Website
// Format: DBML (https://dbml.dbdiagram.io)
// Note: MongoDB is document-based (NoSQL). This file documents the SHAPE
// of each collection. There are no foreign keys / joins between collections
// in Phase 1 - each is independent. Preview this file free at dbdiagram.io
// by pasting it into a new diagram.

Table rooms {
  _id ObjectId [pk]
  name varchar [not null, note: 'e.g. "Deluxe Double Room"']
  description text
  images varchar[] [note: 'array of Cloudinary image URLs']
  price decimal [not null, note: 'base price per night, in local currency']
  discountPercent int [default: 0, note: '0-100, admin controlled']
  capacity int [note: 'max guests']
  featured boolean [default: false, note: 'shown in homepage slideshow']
  createdAt datetime [default: `now()`]
  updatedAt datetime

  Note: 'Managed via admin panel CRUD. Public GET is read-only.'
}

Table menu_items {
  _id ObjectId [pk]
  name varchar [not null, note: 'e.g. "Grilled Salmon"']
  description text
  images varchar[] [note: 'array of Cloudinary image URLs']
  category varchar [note: 'e.g. "Signature Dish", "Starter", "Dessert"']
  price decimal [not null]
  discountPercent int [default: 0, note: '0-100, admin controlled']
  featured boolean [default: false, note: 'shown in homepage slideshow']
  createdAt datetime [default: `now()`]
  updatedAt datetime

  Note: 'Managed via admin panel CRUD. Public GET is read-only.'
}

Table notices {
  _id ObjectId [pk]
  title varchar [not null]
  message text [not null]
  image varchar [note: 'optional Cloudinary image URL']
  active boolean [default: false, note: 'ON/OFF toggle, controls popup visibility']
  createdAt datetime [default: `now()`]
  updatedAt datetime

  Note: 'If zero notices have active=true, no popup renders at all. Multiple active notices stack/overlap on screen.'
}

Table admins {
  _id ObjectId [pk]
  email varchar [not null, unique]
  hashedPassword varchar [not null, note: 'bcrypt hashed, never store plain text']
  createdAt datetime [default: `now()`]
  updatedAt datetime

  Note: 'Single admin account for Phase 1. NextAuth Credentials provider reads from this collection.'
}

Table site_settings {
  _id ObjectId [pk]
  key varchar [not null, unique, note: 'always "main"; this is a singleton']
  hotelName varchar [not null]
  tagline varchar
  description text [note: 'default meta description for SEO']
  address varchar
  phone varchar
  email varchar
  facebookUrl varchar
  instagramUrl varchar
  tiktokUrl varchar
  youtubeUrl varchar
  whatsappUrl varchar
  mapEmbedUrl varchar [note: 'must start with https://www.google.com/maps/embed']
  heroImage varchar [note: 'Cloudinary image URL']
  bannerMessages varchar[] [note: 'max 10, rotate in homepage banner']
  createdAt datetime
  updatedAt datetime
}